(function(){
  var H=window.__THREE_GAME_TEST_HOOKS__;
  var cam=H.getCamera();
  var V=cam.position.constructor;
  var m=cam.matrixWorld;
  var right=new V(m.elements[0],m.elements[1],m.elements[2]);      // cam local +X in world
  var fwd=new V(-m.elements[8],-m.elements[9],-m.elements[10]);   // cam local -Z (true forward)
  var cp=cam.position;
  // Diagonal points 1 unit forward + 1 unit lateral, in FRONT of camera.
  var pRight=new V(cp.x+fwd.x+right.x, cp.y+fwd.y+right.y, cp.z+fwd.z+right.z);
  var pLeft =new V(cp.x+fwd.x-right.x, cp.y+fwd.y-right.y, cp.z+fwd.z-right.z);
  function proj(p){var n=p.clone().project(cam);return {ndcX:+n.x.toFixed(3),ndcZ:+n.z.toFixed(3),front:n.z<1,screenX:Math.round((n.x*0.5+0.5)*window.innerWidth)};}
  return {
    fwdWorld:{x:+fwd.x.toFixed(3),y:+fwd.y.toFixed(3),z:+fwd.z.toFixed(3)},
    rightWorld:{x:+right.x.toFixed(3),y:+right.y.toFixed(3),z:+right.z.toFixed(3)},
    diagForwardRight:proj(pRight),
    diagForwardLeft:proj(pLeft)
  };
})()
