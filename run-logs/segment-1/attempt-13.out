(function(){
  var H=window.__THREE_GAME_TEST_HOOKS__;
  // Give A/D a hair of depth (world +Z 0.05 = toward camera) so projection is finite.
  // logical (x,z) -> world (x, h, -z). To add +0.05 world z, use z = -0.05 logical.
  var out={};
  [['A',-1,-0.05],['D',1,-0.05]].forEach(function(d){
    var p=H.projectLogical(d[1],d[2],0.5);
    var ndc=p.ndc;
    var front=ndc.z<1;
    var horiz=front?(ndc.x<0?'left':(ndc.x>0?'right':'centre')):'behind';
    out[d[0]]={ndcX:+ndc.x.toFixed(3),ndcZ:+ndc.z.toFixed(3),front:front,horiz:horiz,screenX:Math.round(p.screen.x)};
  });
  return out;
})()
