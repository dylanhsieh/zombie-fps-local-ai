// ---------------- aiming / shooting -----------------------------------------
const raycaster = new THREE.Raycaster();

function aimRay() {
  // Authoritative aim: camera centre (NDC (0,0)) — exactly what the crosshair covers.
  raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
  return raycaster;
}

function crosshairTarget() {
  const rc = aimRay();
  let best = null, bestT = Infinity;
  for (const z of zombies) {
    if (!z.alive) continue;
    for (const box of zombieWorldHitboxes(z)) {
      const t = rc.ray.intersectBox(box, new THREE.Vector3());
      if (t && t.distanceTo(rc.ray.origin) < bestT) {
        bestT = rc.ray.distanceTo(t);
        best = { targetId: z.id, point: t, dist: bestT };
      }
    }
  }
  return best;
}

