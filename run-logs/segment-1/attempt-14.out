/bin/zsh -lc "codex-browser eval \"
(function(){
  var H=window.__THREE_GAME_TEST_HOOKS__;
  var cam=H.getCamera();
  var V=cam.position.constructor;
  // Camera world right vector = (cos(yaw), 0, ... ) ; derive from matrixWorld columns 0 and 2.
  // right = cross(up, forward) in world, or matrixWorld col0 (x-axis) for a standard camera.
  var m=cam.matrixWorld;
  var right=new V(m.elements[0],m.elements[1],m.elements[2]); // camera local +X in world
  var fwd=new V(m.elements[8],m.elements[9],m.elements[10]);
  // Project a point 1 unit along world-right from camera position (with forward depth so it's in front).
  // Use camPos + fwd*1 + right*1  => diagonal right; and camPos + fwd*1 - right*1 => diagonal left.
  var cp=cam.position;
  var pR=new V(cp.x+fwd.x+right.x, cp.y+fwd.y+right.y, cp.z+fwd.z+right.z);
  var pL=new V(cp.x+fwd.x-right.x, cp.y+fwd.y-right.y, cp.z+fwd.z-right.z);
  function proj(p){var n=p.clone().project(cam);return {ndcX:+n.x.toFixed(3),ndcZ:+n.z.toFixed(3),front:n.z<1,screenX:Math.round((n.x*0.5+0.5)*window.innerWidth)};}
  return {
    rightWorld:{x:+right.x.toFixed(3),y:+right.y.toFixed(3),z:+right.z.toFixed(3)},
    fwdWorld:{x:+fwd.x.toFixed(3),y:+fwd.y.toFixed(3),z:+fwd.z.toFixed(3)},
    diagRight:proj(pR),
    diagLeft:proj(pL)
  };
})()
