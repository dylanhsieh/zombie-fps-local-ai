/bin/zsh -lc "python3 - <<'EOF'
import re
src = open('game.js').read()
old = \"\"\"function syncCamera() {
  const p = l2w(player.logical.x, player.logical.z);
  camera.position.set(p.x, PLAYER_HEIGHT, p.z);
  camera.rotation.set(0, 0, 0);
  camera.rotateY(player.yaw);
  camera.rotateX(player.pitch);
}\"\"\"
new = \"\"\"function syncCamera() {
  const p = l2w(player.logical.x, player.logical.z);
  camera.position.set(p.x, PLAYER_HEIGHT, p.z);
  camera.quaternion.identity();
  camera.rotateY(player.yaw);
  camera.rotateX(player.pitch);
}\"\"\"
assert old in src
open('game.js','w').write(src.replace(old, new))
print(\"patched\")
