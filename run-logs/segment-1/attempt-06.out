(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  H.respawn(); H.setPlayerPosition(0,0); H.setPitch(0);
  const out = {};
  // aim at zombie A torso
  H.setYaw(Math.atan2(-2.5, 11));
  out.aimA = window.__AGENT_STATE__.crosshair;
  // near-miss: offset +0.06 rad
  H.setYaw(Math.atan2(-2.5, 11) + 0.06);
  out.nearMissA = window.__AGENT_STATE__.crosshair;
  // aim at B (use its current logical pos)
  const B = window.__AGENT_STATE__.zombies[1].logical;
  H.setYaw(Math.atan2(B.x, B.z));
  out.aimB = window.__AGENT_STATE__.crosshair;
  out.Bpos = B;
  // calibration target at logical (0,11) h=1.7
  H.setCalibrationTarget(true);
  H.setYaw(0);
  const tgt = H.projectToScreen(0, 1.7, -11);
  out.calib = { sx: Math.round(tgt.screen.x), sy: Math.round(tgt.screen.y), ndcX: tgt.ndc.x, ndcY: tgt.ndc.y };
  return out;
})()
