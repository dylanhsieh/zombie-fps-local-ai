/bin/zsh -lc "codex-browser eval '(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  H.respawn(); H.setPlayerPosition(0,0); H.setPitch(0);
  H.setYaw(Math.atan2(-2.5, 11));
  const cam = H.getCamera();
  cam.updateMatrixWorld();
  const V = cam.projectionMatrixInverse.constructor;
  const v = new V(0, 0, 0.5);
  const m = new (cam.projectionMatrix.constructor)();
  m.copy(cam.projectionMatrixInverse).multiply(cam.matrixWorldInverse);
  const x = v.x, y = v.y, z = v.z, w = v.w || 1;
  const out = [
    m.elements[0]*x + m.elements[4]*y + m.elements[8]*z + m.elements[12]*w,
    m.elements[1]*x + m.elements[5]*y + m.elements[9]*z + m.elements[13]*w,
    m.elements[2]*x + m.elements[6]*y + m.elements[10]*z + m.elements[14]*w,
    m.elements[3]*x + m.elements[7]*y + m.elements[11]*z + m.elements[15]*w,
  ];
  const px = out[0]/out[3], py = out[1]/out[3], pz = out[2]/out[3];
  const ox = cam.position.x, oy = cam.position.y, oz = cam.position.z;
  let dx = px-ox, dy = py-oy, dz = pz-oz;
  const dl = Math.hypot(dx,dy,dz); dx/=dl; dy/=dl; dz/=dl;
  // point A torso center
  const ax=-2.5, ay=1.225, az=-11;
  const wx=ax-ox, wy=ay-oy, wz=az-oz;
  const t = wx*dx+wy*dy+wz*dz;
  const cx=ox+dx*t, cy=oy+dy*t, cz=oz+dz*t;
  const dist = Math.hypot(ax-cx, ay-cy, az-cz);
