/bin/zsh -lc "codex-browser eval '(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  H.respawn(); H.setPlayerPosition(0,0); H.setPitch(0);
  H.setYaw(Math.atan2(-2.5, 11));
  const cam = H.getCamera();
  cam.updateMatrixWorld();
  // reconstruct the exact ray the game uses: from camera through NDC (0,0)
  const v = new (cam.projectionMatrixInverse.constructor)(0,0,0.5).unproject(cam);
  const dir = v.sub(cam.position).normalize();
  const origin = cam.position.clone();
  const A = { x: -2.5, y: 1.225, z: -11 };
  // distance from point A to ray
  const w = new (dir.constructor)(A.x, A.y, A.z).sub(origin);
  const t = w.dot(dir);
  const closest = origin.clone().addScaledVector(dir, t);
  const distToA = closest.distanceTo(new (dir.constructor)(A.x, A.y, A.z));
  return {
    camPos: origin.toArray(), dir: dir.toArray(), t: t,
    distRayToATorso: distToA,
    crosshair: window.__AGENT_STATE__.crosshair,
  };
})()'" in ~/side-projects/games/web/zombie-fps-local-ai
