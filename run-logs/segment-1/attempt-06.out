(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const st = window.__AGENT_STATE__;
  const cam = H.getCamera();
  const V3 = cam.position.constructor;
  const out = { stYaw: st.camera.yaw, time: st.time };
  // zombie A group: read actual world transform from the live scene graph
  const zA = st.zombies[0];
