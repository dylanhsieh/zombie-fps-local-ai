  #hud .row { display: flex; align-items: center; gap: 8px; }
  #hpbar { width: 220px; height: 10px; background: rgba(0,0,0,.55); border: 1px solid #3d5a48; }
  #hpfill { height: 100%; width: 100%; background: linear-gradient(90deg, #46e07f, #b6ff5e); transition: width .12s; }

  #banner { position: fixed; left: 50%; top: 18%; transform: translateX(-50%);
