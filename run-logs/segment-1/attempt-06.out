  #start h1 { font-size: 26px; margin: 0; letter-spacing: 2px; }
  #start .btn { pointer-events: auto; cursor: pointer; padding: 10px 26px; font: inherit;
    background: #1d3a2a; color: #cfffdf; border: 1px solid #4d8f66; border-radius: 6px; }
  #start .btn:hover { background: #2a5238; }
  #start small { opacity: .75; }
  #start.hidden { display: none; }

  #debug { position: fixed; right: 12px; bottom: 12px; z-index: 11; display: none;
    color: #9fd8ff; font: 11px ui-monospace, Menlo, monospace; text-align: right;
    text-shadow: 0 1px 2px #000; pointer-events: none; }
</style>
