exec
/bin/zsh -lc "cat > /tmp/verify_aim.js <<'EOF'
(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const S = () => window.__AGENT_STATE__;
  const out = { steps: [] };
  const log = (name, data) => out.steps.push({ name, ...data });

  // reset to clean state
  H.respawn();
  H.setPlayerPosition(0, 0);
  H.setYaw(0); H.setPitch(0);

  // AIM A
  const yawA = Math.atan2(-2.5, 11);
  H.setYaw(yawA);
  log('aimA', { yaw, crosshair: S().crosshair });

  // near-miss: offset yaw by +0.06 rad (~3.4 deg) -> should miss A
  H.setYaw(yawA + 0.06);
  log('nearMissA', { crosshair: S().crosshair });
  H.fire();
  log('fireNearMissA', { lastShot: S().lastShot, hpA: S().zombies[0].hp });

  // aim B (read current logical pos)
  const b = S().zombies[1].logical;
  const yawB = Math.atan2(b.x, b.z);
  H.setYaw(yawB);
  log('aimB', { bPos: b, crosshair: S().crosshair });

  // 5-hit kill on B (pin B in place to avoid movement between shots)
  H.setZombiePosition('B', b.x, b.z);
  const seqB = [];
  for (let i = 1; i <= 5; i++) {
    H.fire();
    const z = S().zombies.find(z => z.id === 'B');
    seqB.push({ shot: i, hp: z.hp, alive: z.alive });
  }
  log('killB', { seq: seqB });
  // corpse not targetable
  log('aimBcorpse', { crosshair: S().crosshair });
  H.fire();
  log('fireBcorpse', { lastShot: S().lastShot });

  // reset A, 5-hit kill on A
  H.resetZombieHp('A', 5);
  H.setYaw(yawA);
  const seqA = [];
  for (let i = 1; i <= 5; i++) {
    H.fire();
    const z = S().zombies.find(z => z.id === 'A');
    seqA.push({ shot: i, hp: z.hp, alive: z.alive });
  }
  log('killA', { seq: seqA });
  log('aimAcorpse', { crosshair: S().crosshair });

  // 6th-hit check: reset B, kill in 5, then fire a 6th at corpse -> no hp change, no hit
  H.resetZombieHp('B', 5);
  H.setZombiePosition('B', 2.5, 11);
  H.setYaw(Math.atan2(2.5, 11));
  for (let i = 1; i <= 5; i++) H.fire();
  const hpAfter5 = S().zombies.find(z => z.id === 'B').hp;
  H.fire();
  const after6 = S().zombies.find(z => z.id === 'B');
  log('sixthHit', { hpAfter5, hpAfter6: after6.hp, alive: after6.alive, lastShot: S().lastShot });

  return JSON.stringify(out);
})()
EOF
