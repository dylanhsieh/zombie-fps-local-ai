/bin/zsh -lc "cat > /tmp/dbg_boxes3.js <<'EOF'
(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const scene = H.getCamera().parent;
  let zA = null;
  scene.traverse(o => { if (o.isGroup && Math.abs(o.position.x + 2.5) < 0.01 && Math.abs(o.position.z + 11) < 0.01) zA = o; });
  // local boxes: min + mesh.position (geometry bb is centered on mesh origin)
  const boxes = zA.children.map(c => {
    c.geometry.computeBoundingBox();
    const mn = c.geometry.boundingBox.min.clone().add(c.position);
    const mx = c.geometry.boundingBox.max.clone().add(c.position);
    return { mn: mn.toArray().map(v=>Math.round(v*1000)/1000), mx: mx.toArray().map(v=>Math.round(v*1000)/1000) };
  });
  return JSON.stringify({ boxes });
})()
EOF
