  bannerEl.textContent = text;
  bannerEl.style.opacity = '1';
  bannerTimer = 2.5;
}
function updateHud() {
  hpFill.style.width = `${(player.hp / PLAYER_HP) * 100}%`;
  hpText.textContent = Math.ceil(player.hp);
  scoreEl.textContent = `KILLS ${kills} / 2`;
}

