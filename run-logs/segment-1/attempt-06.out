(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const cam = H.getCamera();
  const V3 = cam.position.constructor;
  H.respawn();
  H.setPlayerPosition(0, 0);
  H.setZombiePosition('B', 2.5, 11);
  const yawA = Math.atan2(-2.5, 11);
  H.setYaw(yawA); H.setPitch(0);
  window.__diag3 = { pending: true };
  const id = setInterval(() => {
    if ("'!window.__THREE_GAME_TEST_HOOKS__) return;
    const st = window.__AGENT_STATE__;
    if (Math.abs(st.camera.yaw - yawA) < 1e-9 && st.time > 0.05) {
      clearInterval(id);
      window.__diag3 = {
        camPos: cam.position.toArray(),
        camFwd: cam.getWorldDirection(new V3()).toArray(),
        unprojectDir: new V3(0,0,0).unproject(cam).sub(cam.position).normalize().toArray(),
        torsoScreen: H.projectToScreen(-2.5, 1.225, -11),
        headScreen: H.projectToScreen(-2.5, 1.86, -11),
        zombieA: st.zombies[0],
        crosshair: st.crosshair,
        yaw: yawA,
      };
    }
  }, 30);
  return '"'waiting';
})()
