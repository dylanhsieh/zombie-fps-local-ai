(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const S = window.__AGENT_STATE__;
  const W = window.innerWidth, Hh = window.innerHeight;
  const c = { x: W/2, y: Hh/2 };
  const proj = (lx, lz) => {
    const p = H.projectLogical(lx, lz, 0.5);
    return { lx, lz, onScreen: p.onScreen, sx: Math.round(p.screen.x), sy: Math.round(p.screen.y),
      dx: Math.round(p.screen.x - c.x), dy: Math.round(p.screen.y - c.y) };
  };
  // spawn orientation
  const spawn = {
    center: c,
    forward: S.camera.forward,
    p01: proj(0, 1), p0m1: proj(0, -1), pm10: proj(-1, 0), p10: proj(1, 0),
  };
  // helper: hold a key for ~700ms, sample displacement
  async function holdMove(code, ms=700) {
    H.releaseAllKeys();
    await new Promise(r => setTimeout(r, 50));
    const before = { ...window.__AGENT_STATE__.player.logical };
    H.holdKey(code);
    await new Promise(r => setTimeout(r, ms));
    H.releaseKey(code);
    const after = { ...window.__AGENT_STATE__.player.logical };
    return { code, before, after, d: { x: +(after.x-before.x).toFixed(3), z: +(after.z-before.z).toFixed(3) } };
  }
  const out = { spawn };
  out.initial = {};
  for (const k of ['KeyW','KeyS','KeyA','KeyD']) out.initial[k] = await holdMove(k);
  // after turning right 90deg (yaw = +PI/2)
  H.setPlayerPosition(0,0); H.setYaw(Math.PI/2); H.releaseAllKeys();
  await new Promise(r => setTimeout(r, 60));
  out.turnRight90 = { yaw: Math.PI/2, forward: window.__AGENT_STATE__.camera.forward };
  out.turnRight90.moves = {};
  for (const k of ['KeyW','KeyS','KeyA','KeyD']) out.turnRight90.moves[k] = await holdMove(k);
  // after turning left 90deg (yaw = -PI/2)
  H.setPlayerPosition(0,0); H.setYaw(-Math.PI/2); H.releaseAllKeys();
  await new Promise(r => setTimeout(r, 60));
  out.turnLeft90 = { yaw: -Math.PI/2, forward: window.__AGENT_STATE__.camera.forward };
  out.turnLeft90.moves = {};
  for (const k of ['KeyW','KeyS','KeyA','KeyD']) out.turnLeft90.moves[k] = await holdMove(k);
  // pitch test: look up, hold W -> y must not change
  H.setPlayerPosition(0,0); H.setYaw(0); H.setPitch(0.9); H.releaseAllKeys();
  await new Promise(r => setTimeout(r, 50));
  const yBefore = window.__AGENT_STATE__.player.world.y;
  H.holdKey('KeyW');
  await new Promise(r => setTimeout(r, 500));
  H.releaseKey('KeyW');
  const yAfter = window.__AGENT_STATE__.player.world.y;
  out.pitchTest = { pitch: 0.9, yBefore, yAfter, yDelta: +(yAfter-yBefore).toFixed(4) };
  // restore
  H.setPlayerPosition(0,0); H.setYaw(0); H.setPitch(0); H.releaseAllKeys();
  return out;
})()
EOF
