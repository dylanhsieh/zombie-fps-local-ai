(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const cam = H.getCamera();
  H.respawn(); H.setPlayerPosition(0,0); H.setYaw(Math.atan2(-2.5,11)); H.setPitch(0);
  const scene = cam.parent;
  let zA = null;
  scene.traverse(o => { if (o.isGroup && Math.abs(o.position.x + 2.5) < 0.01 && Math.abs(o.position.z + 11) < 0.01) zA = o; });
  // compute the game's own world boxes for ALL children using the same formula as game.js
  const p = zA.position;
  const cy = Math.cos(zA.rotation.y), sy = Math.sin(zA.rotation.y);
  const rot = (v) => new (cam.position.constructor)(v.x*cy + v.z*sy, v.y, -v.x*sy + v.z*cy);
  const boxes = zA.children.map(c => {
    c.geometry.computeBoundingBox();
    const mn = rot(c.geometry.boundingBox.min).add(p);
    const mx = rot(c.geometry.boundingBox.max).add(p);
    return {
      mn: mn.toArray().map(v=>Math.round(v*1000)/1000),
      mx: mx.toArray().map(v=>Math.round(v*1000)/1000),
    };
  });
  // ray from camera centre
  const v = new (cam.position.constructor)();
  v.set(0,0,0).unproject(cam);
  const origin = cam.position.clone();
  const dir = v.sub(origin).normalize();
  function slab(origin, dir, mn, mx) {
    let tmin = -Infinity, tmax = Infinity;
    for (let ax = 0; ax < 3; ax++) {
      if (Math.abs(dir.toArray()[ax]) < 1e-12) {
        if (origin.toArray()[ax] < mn[ax] || origin.toArray()[ax] > mx[ax]) return null;
      } else {
        let t1 = (mn[ax] - origin.toArray()[ax]) / dir.toArray()[ax];
        let t2 = (mx[ax] - origin.toArray()[ax]) / dir.toArray()[ax];
        if (t1 > t2) { const tmp = t1; t1 = t2; t2 = tmp; }
        tmin = Math.max(tmin, t1); tmax = Math.min(tmax, t2);
        if (tmin > tmax) return null;
      }
    }
    return tmin >= 0 ? tmin : null;
  }
  const hits = boxes.map((b, i) => ({ i, hitT: slab(origin, dir, b.mn, b.mx) }));
  return JSON.stringify({ boxes, rayOrigin: origin.toArray().map(v=>Math.round(v*1000)/1000), rayDir: dir.toArray().map(v=>Math.round(v*10000)/10000), hits });
})()
