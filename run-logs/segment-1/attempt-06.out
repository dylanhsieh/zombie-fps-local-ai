/bin/zsh -lc "cd ~/side-projects/games/web/zombie-fps-local-ai && python3 - <<'PYEOF'
import re
src = open('game.js').read()

# 1) syncCamera: rotateY(-yaw) so camera matrix matches the logical fwd=(sin,0,-cos)
src = src.replace(
  \"  camera.quaternion.identity();\\n  camera.rotateY(player.yaw);\\n  camera.rotateX(player.pitch);\",
  \"  camera.quaternion.identity();\\n  camera.rotateY(-player.yaw);\\n  camera.rotateX(player.pitch);\"
)

# 2) mouse: mouse right -> turn right -> yaw decreases
src = src.replace(
  \"  player.yaw += e.movementX * MOUSE_SENS;   // mouse right -> yaw+ -> turn right\",
  \"  player.yaw -= e.movementX * MOUSE_SENS;   // mouse right -> turn right -> yaw-\"
)

# 3) zombie facing: face player via camera-style rotation
src = src.replace(
  \"  z.group.rotation.y = Math.atan2(toPlayer.x, toPlayer.z);\",
  \"  z.group.rotation.y = -Math.atan2(toPlayer.x, toPlayer.z);\"
)

# 4) zombieWorldHitboxes: camera-style rotation
src = src.replace(
  \"\"\"  return z.hitboxes.map((hb) => {
    const rot = (v) => new THREE.Vector3(
      v.x * cy + v.z * sy, v.y, -v.x * sy + v.z * cy
    );\"\"\",
  \"\"\"  return z.hitboxes.map((hb) => {
    const rot = (v) => new THREE.Vector3(
      v.x * cy - v.z * sy, v.y, v.x * sy + v.z * cy
    );\"\"\"
)

open('game.js','w').write(src)
print(\"patched\")
