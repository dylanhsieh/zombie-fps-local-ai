  out.torsoScreen = H.projectToScreen(-2.5, 1.225, -11);
  out.headScreen = H.projectToScreen(-2.5, 1.86, -11);
  out.camFwd = cam.getWorldDirection(new V3()).toArray();
  out.unprojectDir = new V3(0,0,0).unproject(cam).sub(cam.position).normalize().toArray();
  out.crosshair = st.crosshair;
  return out;
})()
