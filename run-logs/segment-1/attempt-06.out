/bin/zsh -lc "codex-browser eval '(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  H.respawn(); H.setPlayerPosition(0,0); H.setPitch(0);
  const out = {};
  // aim at zombie A torso: logical (-2.5, 11), height ~1.2
  const yawA = Math.atan2(-2.5, 11);
  H.setYaw(yawA);
  const st = window.__AGENT_STATE__;
  out.aimA = st.crosshair;
  out.camFwd = st.camera.forward;
  // near-miss: offset yaw by +0.06 rad (~3.4 deg)
  H.setYaw(yawA + 0.06);
  out.nearMissA = window.__AGENT_STATE__.crosshair;
  H.fire();
  out.nearMissShot = window.__AGENT_STATE__.lastShot;
  // aim at B
  H.setYaw(Math.atan2(2.5, 11));
  out.aimB = window.__AGENT_STATE__.crosshair;
  // calibration target at logical (0,11) height 1.7: aim straight
  H.setCalibrationTarget(true);
  H.setYaw(0);
  const cam = H.getCamera();
  cam.updateMatrixWorld();
  const ray = new (Object.getPrototypeOf(H.fire) && Function(\"return this\")()) ; // noop
  // compute ray manually via three on window? use camera + raycaster is internal; instead project target center and compare to viewport center
  const tgt = H.projectToScreen(0, 1.7, -11);
  out.calibTargetScreen = { sx: Math.round(tgt.screen.x), sy: Math.round(tgt.screen.y), ndc: tgt.ndc };
  return out;
})()' > /tmp/verify2.json; cat /tmp/verify2.json" in ~/side-projects/games/web/zombie-fps-local-ai
