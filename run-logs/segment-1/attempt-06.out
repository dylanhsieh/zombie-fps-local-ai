  const dir = v.sub(origin).normalize();
  const ray = { origin: origin.clone(), direction: dir.clone() };
  // intersectBox equivalent: slab test
  function intersectBox(ray, box) {
    const inv = new (ray.direction.constructor)().copy(ray.direction).multiplyScalar(1/ (ray.direction.x*ray.direction.x + ray.direction.y*ray.direction.y + ray.direction.z*ray.direction.z));
