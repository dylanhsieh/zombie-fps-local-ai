exec
/bin/zsh -lc "cat > /tmp/diag3.js <<'EOF'
(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const cam = H.getCamera();
  const V3 = cam.position.constructor;
  const out = {};
  H.respawn();
  H.setPlayerPosition(0, 0);
  H.setZombiePosition('B', 2.5, 11);
  const yawA = Math.atan2(-2.5, 11);
  H.setYaw(yawA); H.setPitch(0);
  // wait one frame so the game loop's syncCamera runs with the new yaw
  return new Promise((resolve) => {
    requestAnimationFrame(() => requestAnimationFrame(() => {
      out.camPos = cam.position.toArray();
      out.camFwd = cam.getWorldDirection(new V3()).toArray();
      const v = new V3(0, 0, 0).unproject(cam);
      out.unprojectDir = v.sub(cam.position).normalize().toArray();
      // where is zombie A's torso centre in screen space?
      const p = H.projectToScreen(-2.5, 1.225, -11);
      out.torsoScreen = p;
      // where is zombie A's head centre?
      out.headScreen = H.projectToScreen(-2.5, 1.86, -11);
      // zombie A group world pos + rotation as the game set it
      const st = window.__AGENT_STATE__;
      out.zombieA = st.zombies[0];
      resolve(out);
    }));
  });
})()
EOF
