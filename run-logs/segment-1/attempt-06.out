  const bb = torso.geometry.boundingBox;
  const worldMin = new (cam.position.constructor)(bb.min.x, bb.min.y, bb.min.z).applyMatrix4(torso.matrixWorld);
  const worldMax = new (cam.position.constructor)(bb.max.x, bb.max.y, bb.max.z).applyMatrix4(torso.matrixWorld);
  const box = new (Object.getPrototypeOf(worldMin).constructor)(worldMin, worldMax);
  // ray from camera centre
