/bin/zsh -lc "cat > /tmp/diag.js <<'EOF'
(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const cam = H.getCamera();
  const out = {};
  H.respawn();
  H.setPlayerPosition(0, 0);
  H.setZombiePosition('B', 2.5, 11);
  const yawA = Math.atan2(-2.5, 11);
  H.setYaw(yawA); H.setPitch(0);

  // force camera sync now (same code the loop uses)
  cam.quaternion.identity();
  cam.rotateY(yawA); cam.rotateX(0);
  cam.position.set(0, 1.7, 0);
  cam.updateMatrixWorld(true);

  out.quat = cam.quaternion.toArray();
  out.camFwd = cam.getWorldDirection(new (cam.position.constructor)()).toArray();

  // raycaster from camera centre
  const THREE = window.__THREE_GAME_TEST_HOOKS__ ? null : null;
  // build ray manually: direction from unprojecting NDC (0,0)
  const V3 = cam.position.constructor;
  const v = new V3(0, 0, 0).unproject(cam);
  const dir = v.sub(cam.position).normalize();
  out.unprojectDir = dir.toArray();

  // compare with cameraForwardWorld equivalent
  const cy = Math.cos(yawA), sy = Math.sin(yawA);
  out.expectedFwd = [sy, 0, -cy];

  // zombie A world hitboxes: torso is box(0.62,0.75,0.34) at local (0,1.225,0)
  // zombie A group at world (-2.5, 0, -11), rotation.y = atan2(toPlayer.x, toPlayer.z)
  // toPlayer = (0-(-2.5), 0, 0-(-11)) = (2.5, 0, 11); rotY = atan2(2.5, 11)
  const rotY = Math.atan2(2.5, 11);
  out.zombieARotY = rotY;
  // torso local box: min(-0.31,0.85,-0.17) max(0.31,1.6,0.17)
  // after rotY: x' = x*cy + z*sy ; z' = -x*sy + z*cy
  const c = Math.cos(rotY), s = Math.sin(rotY);
  const rot = (x, y, z) => [x * c + z * s, y, -x * s + z * c];
  const mn = rot(-0.31, 0.85, -0.17), mx = rot(0.31, 1.6, 0.17);
  out.torsoLocalRot = { mn, mx };
  out.torsoWorld = {
    min: [mn[0] - 2.5, mn[1], mn[2] - 11],
    max: [mx[0] - 2.5, mx[1], mx[2] - 11]
  };

  // slab test of ray vs torso world box
  const o = [0, 1.7, 0], d = out.unprojectDir;
  let tmin = -Infinity, tmax = Infinity;
  for (let i = 0; i < 3; i++) {
    const bmin = out.torsoWorld.min[i], bmax = out.torsoWorld.max[i];
    if (Math.abs(d[i]) < 1e-9) {
      if (o[i] < bmin || o[i] > bmax) { tmin = Infinity; tmax = -Infinity; break; }
    } else {
      let t1 = (bmin - o[i]) / d[i], t2 = (bmax - o[i]) / d[i];
      if (t1 > t2) [t1, t2] = [t2, t1];
      tmin = Math.max(tmin, t1); tmax = Math.min(tmax, t2);
    }
  }
  out.slab = { tmin, tmax, hit: tmin <= tmax && tmin > 0 };

  // also: what does the ray look like at t=11 (zombie distance)?
  out.rayAt11 = [o[0] + d[0] * 11, o[1] + d[1] * 11, o[2] + d[2] * 11];
  return out;
})()
