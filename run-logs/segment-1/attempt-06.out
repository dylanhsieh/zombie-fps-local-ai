(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const cam = H.getCamera();
  const V3 = cam.position.constructor;
  const out = {};
  H.respawn();
  H.setPlayerPosition(0, 0);
  H.setZombiePosition('B', 2.5, 11);
  const yawA = Math.atan2(-2.5, 11);
  H.setYaw(yawA); H.setPitch(0);

  cam.quaternion.identity();
  cam.rotateY(-yawA); cam.rotateX(0);
  cam.position.set(0, 1.7, 0);
  cam.updateMatrixWorld(true);

  out.camFwd = cam.getWorldDirection(new V3()).toArray();
  const v = new V3(0, 0, 0).unproject(cam);
  out.unprojectDir = v.sub(cam.position).normalize().toArray();
  const cy = Math.cos(yawA), sy = Math.sin(yawA);
  out.expectedFwd = [sy, 0, -cy];

  // zombie A rotation as the game computes it (now -atan2)
  const rotY = -Math.atan2(2.5, 11);
  const c = Math.cos(rotY), s = Math.sin(rotY);
  const rot = (x, y, z) => [x * c - z * s, y, x * s + z * c];
  const mn = rot(-0.31, 0.85, -0.17), mx = rot(0.31, 1.6, 0.17);
  out.torsoWorld = { min: [mn[0]-2.5, mn[1], mn[2]-11], max: [mx[0]-2.5, mx[1], mx[2]-11] };

  const o = [0, 1.7, 0], d = out.unprojectDir;
  let tmin = -Infinity, tmax = Infinity;
  for (let i = 0; i < 3; i++) {
    const bmin = out.torsoWorld.min[i], bmax = out.torsoWorld.max[i];
    if (Math.abs(d[i]) < 1e-9) { if (o[i] < bmin || o[i] > bmax) { tmin = Infinity; tmax = -Infinity; break; } }
    else {
      let t1 = (bmin - o[i]) / d[i], t2 = (bmax - o[i]) / d[i];
      if (t1 > t2) [t1, t2] = [t2, t1];
      tmin = Math.max(tmin, t1); tmax = Math.min(tmax, t2);
    }
  }
  out.slab = { tmin, tmax, hit: tmin <= tmax && tmin > 0 };
  out.rayAt11 = [o[0] + d[0]*11, o[1] + d[1]*11, o[2] + d[2]*11];
  cam.quaternion.identity();
  return out;
})()
