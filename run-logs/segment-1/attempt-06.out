  H.respawn();
  H.setPlayerPosition(0, 0);
  H.setZombiePosition('B', 2.5, 11);

  // --- aim at zombie A exactly ---
  const yawA = Math.atan2(-2.5, 11);
  H.setYaw(yawA); H.setPitch(0);
  out.aimA = { yaw: yawA, crosshair: S().crosshair, lastShot: S().lastShot };

  // --- near-miss: offset yaw +0.06 rad to the right of A ---
  H.setYaw(yawA + 0.06);
  H.fire();
  out.nearMiss = { crosshair: S().crosshair, lastShot: S().lastShot };

  // --- aim at zombie B at its CURRENT position ---
  const b = S().zombies.find(z => z.id === 'B');
  const yawB = Math.atan2(b.logical.x, b.logical.z);
  H.setZombiePosition('B', b.logical.x, b.logical.z); // pin B
  H.setYaw(yawB); H.setPitch(0);
  out.aimB = { bPos: { ...b.logical }, yaw: yawB, crosshair: S().crosshair };

  // --- 5-hit kill sequence on B ---
  H.setYaw(yawB);
  const seqB = [];
  for (let i = 0; i < 6; i++) {
    H.fire();
    const st = S();
    seqB.push({ shot: i + 1, hp: st.zombies.find(z => z.id === 'B').hp,
      alive: st.zombies.find(z => z.id === 'B').alive,
      hit: st.lastShot.hit, target: st.lastShot.targetId,
      crosshair: st.crosshair ? st.crosshair.targetId : null });
  }
  out.killB = seqB;

  // --- kill A the same way (reset hp first) ---
  H.resetZombieHp('A', 5);
  H.setYaw(yawA);
  const seqA = [];
  for (let i = 0; i < 6; i++) {
    H.fire();
    const st = S();
    seqA.push({ shot: i + 1, hp: st.zombies.find(z => z.id === 'A').hp,
      alive: st.zombies.find(z => z.id === 'A').alive,
      hit: st.lastShot.hit, target: st.lastShot.targetId,
      crosshair: st.crosshair ? st.crosshair.targetId : null });
  }
  out.killA = seqA;
  out.kills = S().kills;
  return out;
})()
