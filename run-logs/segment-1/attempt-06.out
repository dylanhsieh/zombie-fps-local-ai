const ZOMBIE_B_SPEED = 0.9;      // slow approach
const ZOMBIE_MIN_DIST = 2.2;     // stops when close
const PLAYER_HP = 100;
const ZOMBIE_ATTACK_RANGE = 1.6;
const ZOMBIE_ATTACK_DPS = 12;

