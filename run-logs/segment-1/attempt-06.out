  cam.updateMatrixWorld();
  const q = cam.quaternion;
  const cross = (a,b) => [a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]];
  const qxyz=[q.x,q.y,q.z];
  const v=[0,0,-1];
  const c=cross(qxyz,v);
  const dir=[v[0]+2*(q.x*c[0]+q.y*c[1]+q.z*c[2]), v[1]+2*(q.x*c[0]+q.y*c[1]+q.z*c[2]), v[2]+2*(q.x*c[0]+q.y*c[1]+q.z*c[2])];
  const ox=cam.position.x, oy=cam.position.y, oz=cam.position.z;
  const ax=-2.5, ay=1.225, az=-11;
  const wx=ax-ox, wy=ay-oy, wz=az-oz;
  const t=wx*dir[0]+wy*dir[1]+wz*dir[2];
  const cx=ox+dir[0]*t, cy=oy+dir[1]*t, cz=oz+dir[2]*t;
  const dist=Math.hypot(ax-cx, ay-cy, az-cz);
  return { camPos:[ox,oy,oz], dir, t, distRayToATorso: dist, crosshair: window.__AGENT_STATE__.crosshair };
})()
