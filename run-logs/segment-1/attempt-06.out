  return JSON.stringify({
    worldMin: worldMin.toArray().map(v=>Math.round(v*1000)/1000),
    worldMax: worldMax.toArray().map(v=>Math.round(v*1000)/1000),
    rayOrigin: origin.toArray().map(v=>Math.round(v*1000)/1000),
    rayDir: dir.toArray().map(v=>Math.round(v*10000)/10000),
    hitT: slab(origin, dir, worldMin.toArray(), worldMax.toArray()),
  });
})()
