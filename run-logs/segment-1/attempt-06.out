(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const cam = H.getCamera();
  H.respawn();
  H.setPlayerPosition(0,0);
  H.setYaw(Math.atan2(-2.5, 11));
  H.setPitch(0);
  // force a frame sync so camera matrix is current
  cam.updateMatrixWorld();
  const ray = new (cam.raycaster ? window : Object)(); // noop
  const THREE = window.__THREE || null;
  // build ray from camera centre manually
  const v = new (Object.getPrototypeOf(cam.position).constructor)();
  v.set(0,0,0).unproject(cam);
  const origin = cam.position.clone();
  const dir = v.sub(origin).normalize();
  return JSON.stringify({
    camPos: cam.position.toArray(),
    camQuat: cam.quaternion.toArray(),
    rayDir: dir.toArray(),
    camMatrixWorld: cam.matrixWorld.elements,
  });
})()
