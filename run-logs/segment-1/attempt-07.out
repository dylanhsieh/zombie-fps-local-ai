 succeeded in 0ms:
    }
  }
  return best;
}

const gunGroup = new THREE.Group();
{
  const metal = new THREE.MeshStandardMaterial({ color: 0x3a3f45, roughness: 0.4, metalness: 0.7 });
  const dark = new THREE.MeshStandardMaterial({ color: 0x23262a, roughness: 0.5, metalness: 0.5 });
