(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const cam = H.getCamera();
  cam.updateMatrixWorld(true);
  const scene = cam.parent;
  let zA = null;
  scene.traverse((o) => {
    if (o.isGroup && Math.abs(o.position.x) < 0.01 && Math.abs(o.position.z + 11) < 0.01 && o.children.length === 14) {
      zA = o;
    }
  });
  // Replicate zombieWorldHitboxes exactly as game.js does
  const p = zA.position;
  const cy = Math.cos(zA.rotation.y), sy = Math.sin(zA.rotation.y);
  const V3 = p.constructor;
  const boxes = zA.children.map((c, i) => {
    if (i === 13) return null;
    c.geometry.computeBoundingBox();
    const hbMin = c.geometry.boundingBox.min.clone().add(c.position);
    const hbMax = c.geometry.boundingBox.max.clone().add(c.position);
    const rot = (v) => new V3(v.x * cy - v.z * sy, v.y, v.x * sy + v.z * cy);
    const mn = rot(hbMin).add(p);
    const mx = rot(hbMax).add(p);
    // Build a Box3-like object: {min: Vector3, max: Vector3}
    return {
      i,
      min: new V3(Math.min(mn.x, mx.x), Math.min(mn.y, mx.y), Math.min(mn.z, mx.z)),
      max: new V3(Math.max(mn.x, mx.x), Math.max(mn.y, mx.y), Math.max(mn.z, mx.z))
    };
  }).filter(Boolean);
  // Now try intersectBox on each box with the ray
  // Ray: origin (0, 1.7, 0), direction (0, 0, -1)
  const rayOrigin = new V3(0, 1.7, 0);
  const rayDir = new V3(0, 0, -1).normalize();
  // We need a Ray object. Let us construct one using the same constructor as the game's raycaster.ray
  // The game uses THREE.Raycaster, so THREE.Ray exists. But we can't access THREE.
  // Instead, let us use the intersectBox method on a manually constructed ray-like object.
  // Actually, THREE.Ray has intersectBox(box, target). We need a Ray instance.
  // We can get one from the raycaster: raycaster.ray
  // But we don't have access to the raycaster either.
  // Alternative: manually check if the ray passes through each box.
  const results = boxes.map(b => {
    // Slab method
    let tmin = -Infinity, tmax = Infinity;
    for (let d = 0; d < 3; d++) {
      const o = [rayOrigin.x, rayOrigin.y, rayOrigin.z][d];
      const dd = [rayDir.x, rayDir.y, rayDir.z][d];
      const mn = [b.min.x, b.min.y, b.min.z][d];
      const mx = [b.max.x, b.max.y, b.max.z][d];
      if (Math.abs(dd) < 1e-10) {
        if (o < mn || o > mx) return { i: b.i, hit: false };
      } else {
        let t1 = (mn - o) / dd;
        let t2 = (mx - o) / dd;
        if (t1 > t2) { const tmp = t1; t1 = t2; t2 = tmp; }
        tmin = Math.max(tmin, t1);
        tmax = Math.min(tmax, t2);
        if (tmin > tmax) return { i: b.i, hit: false };
      }
    }
    return { i: b.i, hit: true, tmin, tmax };
  });
  return { boxes: boxes.map(b => ({ i: b.i, min: [b.min.x, b.min.y, b.min.z], max: [b.max.x, b.max.y, b.max.z] })), results };
})()
