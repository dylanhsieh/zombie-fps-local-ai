      max = c.geometry.boundingBox.max.clone();
    } else {
      c.geometry.computeBoundingBox();
      min = c.geometry.boundingBox.min.clone();
      max = c.geometry.boundingBox.max.clone();
    }
    // transform to world
    const mn = min.clone().applyMatrix4(c.matrixWorld);
    const mx = max.clone().applyMatrix4(c.matrixWorld);
    return {
      i,
      pos: [c.position.x, c.position.y, c.position.z],
      worldMin: [mn.x, mn.y, mn.z],
      worldMax: [mx.x, mx.y, mx.z]
    };
  });
  return { zApos: [zA.position.x, zA.position.y, zA.position.z], rotY: zA.rotation.y, boxes };
})()
