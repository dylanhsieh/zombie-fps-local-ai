function wall(len, px, pz, rotY) {
  const g = new THREE.Group();
  const body = new THREE.Mesh(new THREE.BoxGeometry(len, WALL_H, 0.4), matWall);
  body.position.y = WALL_H / 2;
  body.castShadow = body.receiveShadow = true;
  g.add(body);
