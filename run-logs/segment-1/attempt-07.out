  trim.position.y = 0.5;
  g.add(trim);
  const trim2 = trim.clone(); trim2.position.y = WALL_H - 0.3; g.add(trim2);
  g.position.set(px, 0, pz);
  g.rotation.y = rotY;
  return g;
}
