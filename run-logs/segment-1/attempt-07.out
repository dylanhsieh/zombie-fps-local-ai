/bin/zsh -lc "cat > /tmp/aim-debug2.js <<'EOF'
(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const cam = H.getCamera();
  H.setZombiePosition('A', 0, 11);
  H.resetZombieHp('A', 5);
  H.setYaw(0); H.setPitch(0);
  // wait one frame via step pattern
  window.__Tn = { step: 0, out: null, timer: setInterval(() => {
    window.__Tn.step++;
    if (window.__Tn.step === 2) {
      cam.updateMatrixWorld(true);
      const camPos = {x: cam.matrixWorld.elements[12], y: cam.matrixWorld.elements[13], z: cam.matrixWorld.elements[14]};
      const test = new (Object.getPrototypeOf(cam.position).constructor)(0,0,0.5);
      test.unproject(cam);
      const dirv = {x: test.x - camPos.x, y: test.y - camPos.y, z: test.z - camPos.z};
      const len = Math.sqrt(dirv.x**2+dirv.y**2+dirv.z**2);
      dirv.x/=len; dirv.y/=len; dirv.z/=len;
      const st = H.getState();
      const zA = st.zombies.find(z=>z.id==='A');
      window.__Tn.out = { camPos, dirv, zAworld: zA.world, crosshair: st.crosshair, lastShot: st.lastShot };
      clearInterval(window.__Tn.timer);
    }
  }, 80)};
  return 'started';
})();
EOF
