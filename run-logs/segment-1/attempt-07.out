const matCrate = new THREE.MeshStandardMaterial({ color: 0x7a5c3a, roughness: 0.8 });
const matCrate2 = new THREE.MeshStandardMaterial({ color: 0x5d6b78, roughness: 0.6, metalness: 0.3 });
