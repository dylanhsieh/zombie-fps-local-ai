(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const cam = H.getCamera();
  H.setZombiePosition('A', 0, 11);
  H.resetZombieHp('A', 5);
  H.setYaw(0); H.setPitch(0);
  cam.updateMatrixWorld(true);
  const v = new (cam.position.constructor)();
  const origin = cam.matrixWorld.elements; // read position
  const camPos = {x: cam.matrixWorld.elements[12], y: cam.matrixWorld.elements[13], z: cam.matrixWorld.elements[14]};
  // direction of NDC(0,0): unproject (0,0,0.5)
  const dir = cam.projectionMatrixInverse ? null : null;
  // use raycaster directly
  const THREE = null; // not global; but camera has methods
  const p = cam.projectionMatrixInverse ? undefined : undefined;
  // compute: point = (0,0,0.5) in NDC -> camera space via inverse projection
  // Easier: use a raycaster built from camera via a trick: camera has no raycaster.
  // Instead replicate: dir = vec(0,0,0.5).unproject(camera) - origin
  const vec = cam.position.clone ? cam.position.clone() : null;
  // Vector3 unproject needs camera; do it via camera methods:
  const test = new (Object.getPrototypeOf(cam.position).constructor)(0,0,0.5);
  test.unproject(cam);
  const dirv = {x: test.x - camPos.x, y: test.y - camPos.y, z: test.z - camPos.z};
  const len = Math.sqrt(dirv.x**2+dirv.y**2+dirv.z**2);
  dirv.x/=len; dirv.y/=len; dirv.z/=len;
  // find zombie A group: walk scene? We have no scene ref. Use hook state for zombie world pos.
  const st = H.getState();
  const zA = st.zombies.find(z=>z.id==='A');
  // torso box in world (from our code knowledge): center (zA.x, 1.225, zA.z), half (0.31,0.375,0.17)
  const cx = zA.world.x, cy = 1.225, cz = zA.world.z;
  const hx = 0.31, hy = 0.375, hz = 0.17;
  // slab test
  const res = {};
  for (const [axis, c, h, o, d] of [
    ['x', cx, hx, camPos.x, dirv.x],
    ['y', cy, hy, camPos.y, dirv.y],
    ['z', cz, hz, camPos.z, dirv.z],
  ]) {
    if (Math.abs(d) < 1e-12) {
      res[axis] = (Math.abs(o - c) <= h) ? [0, Infinity] : 'MISS';
    } else {
      const t1 = (c - h - o) / d, t2 = (c + h - o) / d;
      res[axis] = [Math.min(t1,t2), Math.max(t1,t2)];
    }
  }
  return { camPos, dirv, zA, slab: res };
})();
EOF
