(() => {
  const H = window.__THREE_GAME_TEST_HOOKS__;
  const cam = H.getCamera();
  cam.updateMatrixWorld(true);
  const scene = cam.parent;
  let zA = null;
  scene.traverse((o) => {
    if (o.isGroup && Math.abs(o.position.x) < 0.01 && Math.abs(o.position.z + 11) < 0.01 && o.children.length === 14) {
      zA = o;
    }
  });
  // Now replicate zombieWorldHitboxes logic manually
  const p = zA.position;
  const cy = Math.cos(zA.rotation.y), sy = Math.sin(zA.rotation.y);
  const boxes = zA.children.map((c, i) => {
    if (i === 13) return null; // bar mesh
    c.geometry.computeBoundingBox();
    const hbMin = c.geometry.boundingBox.min.clone().add(c.position);
    const hbMax = c.geometry.boundingBox.max.clone().add(c.position);
    const rot = (v) => new (p.constructor)(v.x * cy - v.z * sy, v.y, v.x * sy + v.z * cy);
    const mn = rot(hbMin).add(p);
    const mx = rot(hbMax).add(p);
    return {
      i,
      mn: [mn.x, mn.y, mn.z],
      mx: [mx.x, mx.y, mx.z]
    };
  });
  // Now replicate the aim ray
  const V2 = (function(){ const el = document.createElement('canvas'); return null; })();
  // We can't access THREE directly. But we can use the raycaster via the game's own crosshairTarget.
  // Instead, let's just check: does the ray from camera through center hit box i=2 (torso)?
  // Camera at (0,1.7,0), direction (0,0,-1) (yaw=0, pitch=0)
  // Torso box: x [-0.31, 0.31], y [0.85, 1.6], z [-11.17, -10.83]
  // Ray: x=0 (in range), y=1.7 (NOT in [0.85, 1.6]"'!), z goes from 0 to -11 (passes through z range)
  // So the ray at y=1.7 does NOT intersect the torso box which tops out at y=1.6!
  // The head box: y [1.65, 2.07], x [-0.21, 0.21], z [-11.21, -10.79]
  // Ray y=1.7 IS in [1.65, 2.07], x=0 in range, z passes through. So it should hit the HEAD.
  // Let'"'s verify by checking all boxes against the ray.
  const rayOrigin = [0, 1.7, 0];
  const rayDir = [0, 0, -1];
  const hits = boxes.filter(b => b).map(b => {
    // Ray-AABB intersection (slab method)
    let tmin = -Infinity, tmax = Infinity;
    for (let d = 0; d < 3; d++) {
      if (Math.abs(rayDir[d]) < 1e-10) {
        if (rayOrigin[d] < b.mn[d] || rayOrigin[d] > b.mx[d]) return null;
      } else {
        let t1 = (b.mn[d] - rayOrigin[d]) / rayDir[d];
        let t2 = (b.mx[d] - rayOrigin[d]) / rayDir[d];
        if (t1 > t2) { const tmp = t1; t1 = t2; t2 = tmp; }
        tmin = Math.max(tmin, t1);
        tmax = Math.min(tmax, t2);
        if (tmin > tmax) return null;
      }
    }
    return { i: b.i, tmin, tmax };
  }).filter(Boolean);
  return { boxes: boxes.filter(b => b), hits };
})()
