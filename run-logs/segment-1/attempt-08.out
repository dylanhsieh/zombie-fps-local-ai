codex
Found it — `ray.distanceTo` is a `Vector3` method, not a `Ray` method. `crosshairTarget()` throws every frame, so `fire()` can never register a hit. Fixing now.


exec
/bin/zsh -lc "python3 - <<'EOF'
src = open('game.js').read()
old = \"\"\"      const t = rc.ray.intersectBox(box, new THREE.Vector3());
      if (t && t.distanceTo(rc.ray.origin) < bestT) {
        bestT = rc.ray.distanceTo(t);
        best = { targetId: z.id, point: t, dist: bestT };
      }\"\"\"
new = \"\"\"      const t = rc.ray.intersectBox(box, new THREE.Vector3());
      if (t) {
        const d = t.distanceTo(rc.ray.origin);
        if (d < bestT) {
          bestT = d;
          best = { targetId: z.id, point: t, dist: d };
        }
      }\"\"\"
assert old in src
src = src.replace(old, new, 1)
open('game.js','w').write(src)
print(\"fixed\")
