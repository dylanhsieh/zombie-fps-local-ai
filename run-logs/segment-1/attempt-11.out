    var front=ndc.z<1;
    var horiz=front?(ndc.x<0?'left':(ndc.x>0?'right':'centre')):'behind';
    out[d[0]]={ndcX:+ndc.x.toFixed(3),ndcZ:+ndc.z.toFixed(3),front:front,horiz:horiz};
  });
  return out;
})()
